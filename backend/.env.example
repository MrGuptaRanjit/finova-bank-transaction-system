# Server Port
PORT=3000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/backend-ledger

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# -------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (Choose Option 1, 2, or 3)
# -------------------------------------------------------------

# OPTION 1: Gmail App Password (RECOMMENDED - Does NOT expire)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Fill in your Gmail and the 16-character password below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# OPTION 2: Google OAuth2 (Tokens in testing mode expire every 7 days)
# CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# CLIENT_SECRET=your_google_oauth_client_secret
# REFRESH_TOKEN=your_google_oauth_refresh_token

# OPTION 3: Custom SMTP Provider (Resend, SendGrid, Brevo, AWS SES, Mailtrap)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_api_key
